# ---------------------------------------------------------------------------
# Markaz — environment
#
# Every variable below has a working default, so the app boots with no .env at
# all. That is a convenience for local work, not a production posture: in prod
# you should set SECRET_KEY, DATABASE_URL, and ENVIRONMENT explicitly.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Environment label. One of: development | staging | production | test.
ENVIRONMENT=development

# Signing key for JWTs. Optional locally — if unset, the app generates a random
# key at startup and logs a warning. The consequence is that every restart
# invalidates all existing sessions, so set this in anything shared.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# JWT algorithm and lifetime.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# bcrypt cost. 12 is ~250ms per hash on this class of hardware. Lower it only
# in tests (4 makes the suite roughly 30x faster).
BCRYPT_ROUNDS=12

# --- Database ---------------------------------------------------------------
# Postgres in Docker; falls back to SQLite with WAL when you just want it to run.
# DATABASE_URL=postgresql+psycopg://markaz:markaz@localhost:5432/markaz
DATABASE_URL=sqlite:///./markaz.db

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser. The bundled
# SPA is same-origin, so this only matters if you host the UI elsewhere.
# Never use "*" with allow_credentials=True — browsers reject it anyway.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Rate limiting ----------------------------------------------------------
# Per-client sliding window, per minute. Mutating requests only.
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Deployment (Vercel / Docker) -------------------------------------------
# Only needed for the deploy path, not for local runs.
# VERCEL_TOKEN=
